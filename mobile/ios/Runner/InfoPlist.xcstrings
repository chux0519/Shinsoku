{
  "sourceLanguage" : "en",
  "strings" : {
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Permission prompt: local network (Nearby desktop)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shinsoku verwendet dein lokales Netzwerk, um deinen Shinsoku-Computer zu finden und sich mit ihm zu verbinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shinsoku uses your local network to find and connect to your Shinsoku desktop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shinsoku usa tu red local para encontrar tu ordenador con Shinsoku y conectarse a él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shinsoku utilise votre réseau local pour trouver votre ordinateur Shinsoku et s’y connecter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shinsoku usa la rete locale per trovare il tuo computer con Shinsoku e connettersi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shinsokuはローカルネットワークを使って、お使いのShinsokuデスクトップを探して接続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shinsoku는 로컬 네트워크를 사용해 Shinsoku 데스크톱을 찾고 연결해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Shinsoku usa sua rede local para encontrar e se conectar ao seu computador com Shinsoku."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shinsoku 使用本地网络查找并连接你的 Shinsoku 电脑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shinsoku 會使用區域網路尋找並連線到你的 Shinsoku 電腦。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Permission prompt: microphone",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shinsoku nimmt deine Stimme beim Diktieren auf und sendet sie an den gewählten Spracherkennungsdienst oder an deinen gekoppelten Computer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shinsoku records your voice while you dictate and sends it to the speech provider you chose, or to your paired computer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shinsoku graba tu voz mientras dictas y la envía al proveedor de voz que elegiste o a tu ordenador vinculado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shinsoku enregistre votre voix pendant la dictée et l’envoie au service de reconnaissance vocale choisi ou à votre ordinateur jumelé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shinsoku registra la tua voce mentre detti e la invia al servizio vocale scelto o al tuo computer abbinato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声入力の間、Shinsokuはマイクで録音し、選んだ音声認識サービスまたはペアリングしたデスクトップに送ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shinsoku는 받아쓰는 동안 음성을 녹음해 선택한 음성 인식 서비스나 페어링한 데스크톱으로 보내요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Shinsoku grava sua voz enquanto você dita e a envia ao provedor de voz escolhido ou ao seu computador pareado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shinsoku 在你听写时录音，并发送到你选择的语音识别服务或已配对的电脑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shinsoku 會在你聽寫時錄音，並傳送到你選擇的語音辨識服務或已配對的電腦。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
