    "NSLocalNetworkUsageDescription" : {
      "comment" : "Permission prompt: local network (Nearby desktop)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shinsoku verwendet dein lokales Netzwerk, um deinen Shinsoku-Computer zu finden und sich mit ihm zu verbinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shinsoku uses your local network to find and connect to your Shinsoku desktop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shinsoku usa tu red local para encontrar tu ordenador con Shinsoku y conectarse a él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
